{
  "name": "tiny-brain-wallet",
  "version": "0.0.2",
  "description": "A minimalistic crypto HD wallet",
  "author": "Piotr Pietras <pietraspiotr94@gmail.com>",
  "license": "ISC",
  "main": "src/main/out/index.js",
  "scripts": {
    "bundle": "node bundler.js",
    "start": "node bundler.js --start",
    "start:dev": "node bundler.js --start --watch ",
    "build": "npx electron-builder --linux --win"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@types/node": "~22.7.7",
    "@types/react": "^19.2.7",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "ecpair": "^2.1.0",
    "ethers": "^6.16.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.12.0",
    "tiny-secp256k1": "^2.2.4"
  },
  "build": {
    "appId": "com.tinybrainwallet.app",
    "productName": "tinybrainwallet",
    "icon": "res/icon.png",
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        "res"
      ],
      "artifactName": "tinybrainwallet-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "artifactName": "tinybrainwallet-${version}-linux-${arch}.${ext}"
    }
  }
}
